<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.krm-demo</groupId>
        <artifactId>plans-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>plan-equilib</artifactId>
    <name>plan-equilib</name>
    <description>Balances Equilibrium: the swept amount per current balance as an SVG without JavaScript, and its Lambda</description>

    <!-- No runtime dependencies on purpose: the jar itself is the Lambda package (a few dozen KB, fast cold start). -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>plan-equilib</finalName>
        <plugins>
            <!--
              Regenerates the example pictures of the README in docs/ on every build; commit them.
              On its own (from the repo root): mvn -pl plan-equilib compile exec:java@docs
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>docs</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.krmdemo.plansinstr.equilib.EquilibDocs</mainClass>
                            <arguments>
                                <argument>${project.basedir}/docs</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
