<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.krm-demo</groupId>
        <artifactId>plans-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>plans-math</artifactId>
    <name>plans-math</name>
    <description>The math of the plans, as a library: Balances Equilibrium draws the swept amount per current balance as an SVG without JavaScript</description>

    <properties>
        <jacoco.version>0.8.14</jacoco.version>
        <open-test-reporting.version>0.2.5</open-test-reporting.version>
        <!-- where JUnit writes the Open Test Reporting XML (the workflow passes the actual file, see plans-math.yml) -->
        <otr.xml>${project.build.directory}/open-test-report/open-test-report.xml</otr.xml>
        <otr.html>${project.build.directory}/open-test-report/index.html</otr.html>
    </properties>

    <!-- Versions of Thymeleaf, SLF4J and JUnit come from the Spring Boot BOM of the parent (no Spring at runtime). -->
    <dependencies>
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf</artifactId>
        </dependency>
        <!-- Thymeleaf logs through SLF4J; the tests and the pictures have nothing to say there. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Writes the Open Test Reporting XML (with the pictures the tests publish), see junit-platform.properties. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-reporting</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>plans-math</finalName>
        <plugins>
            <!-- Coverage of the tests: target/site/jacoco (HTML, XML, CSV), published on GitHub Pages. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine}: the JaCoCo agent -->
                    <argLine>@{argLine}</argLine>
                </configuration>
                <executions>
                    <!-- The technical tests: everything not tagged "demo"; their own Open Test Reporting XML. -->
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>demo</excludedGroups>
                            <properties>
                                <configurationParameters>
                                    junit.platform.reporting.open.xml.enabled = true
                                    junit.platform.reporting.output.dir = ${project.build.directory}/open-test-report/tech
                                </configurationParameters>
                            </properties>
                        </configuration>
                    </execution>
                    <!-- The demo tests (@Tag("demo")): what the demo page shows, with the pictures; a report of their own. -->
                    <execution>
                        <id>demo-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>demo</groups>
                            <properties>
                                <configurationParameters>
                                    junit.platform.reporting.open.xml.enabled = true
                                    junit.platform.reporting.output.dir = ${project.build.directory}/open-test-report/demo
                                </configurationParameters>
                            </properties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The JavaDoc of the library (target/reports/apidocs), published on GitHub Pages next to the reports. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doctitle>plans-math: Balances Equilibrium</doctitle>
                    <windowtitle>plans-math</windowtitle>
                    <doclint>all,-missing</doclint>
                    <links>
                        <link>https://docs.oracle.com/en/java/javase/21/docs/api/</link>
                    </links>
                </configuration>
                <executions>
                    <execution>
                        <id>apidocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              exec:java@docs writes the pictures of the README into target/pages/plans-math/svg (published on GitHub Pages).
              exec:java@open-test-html turns the Open Test Reporting XML into one HTML page (with the pictures);
              run it after the tests (from the repo root):
                mvn -pl plans-math compile exec:java@docs
                mvn -pl plans-math exec:java@open-test-html -Dotr.xml=... -Dotr.html=...
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>docs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.krmdemo.plansinstr.equilib.EquilibDocs</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/pages/plans-math/svg</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The demo page (src/site, Thymeleaf) with the numbers of the tests and the coverage. -->
                        <id>demo-page</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <classpathScope>test</classpathScope>
                            <mainClass>org.krmdemo.plansinstr.equilib.DemoPage</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/pages/plans-math</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>open-test-html</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <mainClass>org.opentest4j.reporting.cli.ReportingCli</mainClass>
                            <arguments>
                                <argument>html-report</argument>
                                <argument>--output</argument>
                                <argument>${otr.html}</argument>
                                <argument>${otr.xml}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.opentest4j.reporting</groupId>
                        <artifactId>open-test-reporting-cli</artifactId>
                        <version>${open-test-reporting.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

        </plugins>
    </build>
</project>
